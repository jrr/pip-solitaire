node_modules/

# ReScript compiler output (in-source builds emit alongside sources). Scoped to
# each package's root, which is where the compiler puts it — an unanchored `lib/`
# also swallowed hand-written ones further down (scripts/lib, browser-tests/lib).
packages/*/lib/
*.res.mjs

# Vite build output. `dist-profile/` is the readable-frames build `mise run
# profile` measures (vite.config.profile.js) — same status as `dist/`, and named
# separately because the pattern above matches a directory called exactly `dist`.
dist/
packages/web-app/dist-profile/

# Generated screenshot report — a CI artifact, not source. Anchored for the same
# reason as `packages/*/lib/` above: unanchored, it also swallowed the
# hand-written scripts/screenshots/ (the code that *renders* the report).
packages/web-app/screenshots/

# Playwright run output (traces, HTML report) from `mise run browsertest`.
test-results/
playwright-report/
